{% extends "layouts/site.njk" %}
{% from "partials/form.njk" import field_error, form_error %}

{% block content %}
<section class="auth">
  <form class="card auth__card" action="/register" method="post" novalidate>
    <a href="/" class="auth__logo" aria-label="QR DINE">{{ brandMark() }}</a>
    <h1>Тіркелу</h1>
    <p class="muted">Тапсырыстар тарихын сақтау үшін аккаунт ашыңыз</p>

    {{ form_error(errors) }}

    <label class="field">
      <span class="field__label">Аты-жөніңіз</span>
      <input class="input" name="name" required maxlength="60" autocomplete="name" autofocus value="{{ values.name }}">
      {{ field_error(errors, 'name') }}
    </label>
    <label class="field">
      <span class="field__label">Email</span>
      <input class="input" name="email" type="email" required autocomplete="email" value="{{ values.email }}">
      {{ field_error(errors, 'email') }}
    </label>
    <div class="form-row">
      <label class="field">
        <span class="field__label">Құпиясөз</span>
        <input class="input" name="password" type="password" required minlength="8" autocomplete="new-password">
        {{ field_error(errors, 'password') }}
      </label>
      <label class="field">
        <span class="field__label">Қайталаңыз</span>
        <input class="input" name="password_confirm" type="password" required autocomplete="new-password">
        {{ field_error(errors, 'password_confirm') }}
      </label>
    </div>

    <button class="btn btn--primary btn--block btn--lg" type="submit">Аккаунт ашу</button>
    <p class="auth__switch">Аккаунтыңыз бар ма? <a href="/login">Кіру</a></p>
  </form>
</section>
{% endblock %}
