# Скопируйте этот файл в .env и при необходимости поменяйте значения.

# development | production
NODE_ENV=development
PORT=3000

# Публичный адрес сайта — используется в QR-кодах столов.
# Для теста с телефона в локальной сети укажите IP компьютера, например http://192.168.1.10:3000
BASE_URL=http://localhost:3000

# Секрет для подписи cookie-сессий (в production — обязательно длинная случайная строка)
SESSION_SECRET=change-me-to-a-long-random-string

# Администратор создаётся автоматически при первом запуске, если в базе ещё нет админа.
# Данные для входа в /admin в режиме разработки:
ADMIN_NAME=Әкімші
ADMIN_EMAIL=admin@qrdine.kz
ADMIN_PASSWORD=admin12345

# Смещение часового пояса для статистики «за сегодня» (Казахстан = UTC+5)
TZ_OFFSET_HOURS=5
